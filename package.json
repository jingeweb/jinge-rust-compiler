{
  "name": "jinge-compiler",
  "version": "4.1.9",
  "description": "compiler for jinge framework",
  "author": "Yuhang Ge<abeyuhang@gmail.com>",
  "license": "ISC",
  "type": "module",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "bin": {
    "intl-extract": "./dist/cli/intl-extract.js",
    "intl-compile": "./dist/cli/intl-compile.js"
  },
  "keywords": [
    "jinge",
    "compiler",
    "swc"
  ],
  "scripts": {
    "build-ts": "rm -rf dist types && tsc -project tsconfig.types.json && tsup-node ts/index.ts ts/cli/intl-extract.ts ts/cli/intl-compile.ts  --sourcemap --format esm",
    "build-cargo-debug": "cargo build && cp target/debug/libjinge_compiler.so index.node 2>/dev/null || : && cp target/debug/libjinge_compiler.dylib index.node 2>/dev/null || :",
    "watch-cargo": "nodemon -e rs --watch src --exec 'pnpm build-cargo-debug'",
    "dev": "concurrently \"pnpm build-ts --watch\" \"pnpm watch-cargo\"",
    "build": "pnpm lint && pnpm build-ts --silent && echo 'Build ts done. Use github actions to build and release rust core!!'",
    "patch-version": "tsx scripts/version.ts",
    "lint-fix": "oxlint --type-aware --fix && biome format --fix",
    "lint": "tsc --noEmit && oxlint --type-aware && biome format",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "oxlint --type-aware --fix",
      "biome format --fix"
    ]
  },
  "files": [
    "package.json",
    "LICENSE",
    "README.md",
    "ts",
    "dist",
    "types"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@types/node": "^24.7.2",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "nodemon": "^3.1.10",
    "oxlint": "^1.22.0",
    "oxlint-tsgolint": "^0.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "vite": "^7.1.9"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "jinge-compiler-core-linux-aarch64": "4.1.9",
    "jinge-compiler-core-linux-x86_64": "4.1.9",
    "jinge-compiler-core-macos-aarch64": "4.1.9",
    "jinge-compiler-core-macos-x86_64": "4.1.9",
    "jinge-compiler-core-windows-x86_64": "4.1.9",
    "typescript": "^5.9.3"
  }
}
