{
  "name": "jinge-compiler",
  "version": "4.1.13",
  "description": "Template compiler for jinge framework",
  "keywords": [
    "compiler",
    "jinge"
  ],
  "homepage": "https://github.com/jingeweb/jinge-rust-compiler#readme",
  "bugs": {
    "url": "https://github.com/jingeweb/jinge-rust-compiler/issues"
  },
  "license": "AGPL-3.0",
  "author": "Yuhang Ge <abeyuhang@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jingeweb/jinge-rust-compiler.git"
  },
  "bin": {
    "intl-compile": "./dist/cli/intl-compile.js",
    "intl-extract": "./dist/cli/intl-extract.js"
  },
  "files": [
    "package.json",
    "LICENSE",
    "README.md",
    "ts",
    "dist",
    "types"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "scripts": {
    "build": "pnpm lint && pnpm build-ts --silent && echo 'Build ts done. Use github actions to build and release rust core!!'",
    "build-cargo-debug": "cargo build && cp target/debug/libjinge_compiler.so index.node 2>/dev/null || : && cp target/debug/libjinge_compiler.dylib index.node 2>/dev/null || :",
    "build-ts": "rm -rf dist types && tsc -project tsconfig.types.json && tsup-node ts/index.ts ts/cli/intl-extract.ts ts/cli/intl-compile.ts  --sourcemap --format esm",
    "dev": "concurrently \"pnpm build-ts --watch\" \"pnpm watch-cargo\"",
    "lint": "tsc --noEmit && oxlint --type-aware && oxfmt --check",
    "lint-fix": "oxlint --type-aware --fix && oxfmt",
    "lint-staged": "lint-staged",
    "patch-version": "npm version patch",
    "prepare": "husky",
    "release:patch": "npm version patch",
    "test": "pnpm test:release && pnpm test:rust && pnpm test:integration",
    "test:chrome": "node test/e2e/check-chrome.mjs",
    "test:coverage": "node test/coverage.mjs",
    "test:e2e": "node test/e2e/run.mjs",
    "test:integration": "node test/run.mjs",
    "test:pending": "node test/run.mjs test/integration/pending.test.mjs",
    "test:release": "node --test test/release.test.mjs",
    "test:rust": "cargo test --locked",
    "test:types": "tsc --noEmit -p test/tsconfig.json",
    "test:update": "UPDATE_RUST_SNAPSHOTS=1 cargo test --locked tests::codegen",
    "version": "node scripts/sync-version.mjs",
    "watch-cargo": "nodemon -e rs --watch src --exec 'pnpm build-cargo-debug'"
  },
  "dependencies": {
    "@typescript/typescript6": "^6.0.2",
    "csv-parse": "^7.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "bun": "^1.4.4",
    "concurrently": "^10.0.6",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jsdom": "30.1.3",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "v8-to-istanbul": "9.3.0",
    "vite": "^8.3.5"
  },
  "optionalDependencies": {
    "jinge-compiler-darwin-arm64": "4.1.13",
    "jinge-compiler-darwin-x64": "4.1.13",
    "jinge-compiler-linux-arm64": "4.1.13",
    "jinge-compiler-linux-x64": "4.1.13",
    "jinge-compiler-win32-x64": "4.1.13"
  },
  "lint-staged": {
    "!(test/**).{js,ts}": [
      "oxlint --type-aware --fix",
      "oxfmt"
    ]
  }
}
